{
  "info": {
    "name": "AppSalon API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base",
      "value": "http://localhost/appsalon/public/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "usuarioId",
      "value": "2"
    },
    {
      "key": "citaId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login cliente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/auth/login",
              "host": [
                "{{base}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"cliente@appsalon.com\",\n  \"password\": \"cliente123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "if (j.ok) { pm.collectionVariables.set('token', j.data.token); pm.collectionVariables.set('usuarioId', j.data.usuario.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Login admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/auth/login",
              "host": [
                "{{base}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@appsalon.com\",\n  \"password\": \"admin123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "if (j.ok) { pm.collectionVariables.set('token', j.data.token); pm.collectionVariables.set('usuarioId', j.data.usuario.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base}}/auth/logout",
              "host": [
                "{{base}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Servicios",
      "item": [
        {
          "name": "Listar servicios",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base}}/servicios",
              "host": [
                "{{base}}"
              ],
              "path": [
                "servicios"
              ]
            }
          }
        },
        {
          "name": "Ver servicio",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base}}/servicios/1",
              "host": [
                "{{base}}"
              ],
              "path": [
                "servicios",
                "1"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Citas",
      "item": [
        {
          "name": "Citas del usuario",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base}}/citas/usuario/{{usuarioId}}",
              "host": [
                "{{base}}"
              ],
              "path": [
                "citas",
                "usuario",
                "{{usuarioId}}"
              ]
            }
          }
        },
        {
          "name": "Ver cita",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base}}/citas/{{citaId}}",
              "host": [
                "{{base}}"
              ],
              "path": [
                "citas",
                "{{citaId}}"
              ]
            }
          }
        },
        {
          "name": "Crear cita",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/citas",
              "host": [
                "{{base}}"
              ],
              "path": [
                "citas"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fecha\": \"2026-11-23\",\n  \"hora\": \"10:00\",\n  \"servicios\": [\n    2\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json(); if (j.ok) pm.collectionVariables.set('citaId', j.data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Reprogramar cita",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/citas/{{citaId}}",
              "host": [
                "{{base}}"
              ],
              "path": [
                "citas",
                "{{citaId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fecha\": \"2026-11-23\",\n  \"hora\": \"15:00\",\n  \"servicios\": [\n    2\n  ]\n}"
            }
          }
        },
        {
          "name": "Cancelar cita",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/citas/{{citaId}}",
              "host": [
                "{{base}}"
              ],
              "path": [
                "citas",
                "{{citaId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"cancelada\"\n}"
            }
          }
        },
        {
          "name": "Confirmar cita (admin)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/citas/{{citaId}}",
              "host": [
                "{{base}}"
              ],
              "path": [
                "citas",
                "{{citaId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"confirmada\"\n}"
            }
          }
        }
      ]
    }
  ]
}