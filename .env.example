# Copiar como .env (está en .gitignore) y completar. NUNCA subir .env al repositorio.

# Puerto del host donde se publica la app: http://localhost:8080
APP_PORT=8080

# Vacío en Docker: Apache sirve public/ como raíz del sitio
BASE_URL=

# Solo para HTTPS (docker-compose.https.yml): dominio que apunta a la IP de la VM
DOMAIN=

# Base de datos (el contenedor db la crea con estos datos la primera vez)
DB_NAME=appsalon_mvc_php
DB_USER=appsalon
DB_PASS=cambia_esta_clave
DB_ROOT_PASS=cambia_esta_otra_clave

# Correo con Brevo (SMTP & API -> SMTP). SMTP_PASS es la "SMTP key", no tu contraseña
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_NAME=AppSalon Citas
